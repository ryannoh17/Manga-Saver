{
    "name": "Manga Saver", 
    "version": "0.0.1.0",
    "description": "Saves your manga",
    "action": {
        "default_popup": "index.html"
    },
    "manifest_version": 3,
    "icons": {
        "128": "Zerotwomain.png"
    },
	"background": {
        "service_worker": "worker.js"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "tabs",
        "webNavigation",
        "storage"
     ],
     "host_permissions": ["https://manga-saver-456109800501.us-east1.run.app/*"]
}